# ---- Core ----
DSS_ENV=local
DSS_SECRET_KEY=change-me-in-production-please-32-chars-min
DSS_LOG_LEVEL=INFO

# ---- Database ----
# Inside docker compose the host is `postgres:5432`; from the host machine the
# container is published on 55432 (5432 is usually taken by a local PostgreSQL).
DSS_DATABASE_URL=postgresql+psycopg://dss:dss@localhost:55432/dss

# ---- Auth (MVP: single admin user seeded by `dss seed`) ----
# Avoid reserved domains such as .local / .test -- email-validator rejects them.
DSS_ADMIN_EMAIL=admin@dss-demo.com
DSS_ADMIN_PASSWORD=admin12345
DSS_ACCESS_TOKEN_TTL_MINUTES=720

# Skip the login screen: every request is treated as the admin above.
# Handy while building the UI. The server ignores this unless DSS_ENV=local,
# so it cannot open up a deployed instance -- but set it to false before
# putting the API anywhere another machine can reach.
DSS_AUTH_DISABLED=true

# ---- Embeddings / product matching ----
# "tfidf-svd" is pure scikit-learn and the default. "sentence-transformer"
# needs the optional extra: pip install -e "backend[transformers]" (~2.5 GB).
DSS_EMBEDDER=tfidf-svd
DSS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DSS_EMBEDDING_DIM=384
# Auto-accept is set by scripts/tune_match_threshold.py: the lowest score with
# zero false positives pooled across several generated markets.
DSS_MATCH_AUTO_ACCEPT=0.86
DSS_MATCH_REVIEW_FLOOR=0.60

# ---- Local LLM (Module F advisor) ----
DSS_OLLAMA_BASE_URL=http://localhost:11434
DSS_OLLAMA_MODEL=llama3.1:8b
DSS_LLM_ENABLED=true

# ---- Ingestion ----
DSS_SCHEDULER_ENABLED=true
DSS_CRAWL_INTERVAL_MINUTES=60
# Comma separated allowlist for the generic HTTP connector (SSRF guard).
DSS_HTTP_CONNECTOR_ALLOWLIST=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
